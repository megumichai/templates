{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/web/*", "./src/web/*.vue"]
    }
  },
  "include": [
    "src/web/**/*.ts",
    "src/web/**/*.vue",
    "src/web/**/*.d.ts",
    "typed-router.d.ts",
    "vite.config.ts"
  ],
  "exclude": ["src/server"]
}
